<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions. Merged into the debug variant only, so the token gallery
     cannot reach a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">
        <!--
            The gallery specimens are exported so they can be launched explicitly from adb,
            but they carry NO launcher intent-filter: a debug-only tool must never add a
            home-screen icon that competes with the real app and gets opened by mistake.
            Launch when needed:
              adb shell am start -n dev.rishabh.dailytracker/.debug.TokenGalleryActivity
              adb shell am start -n dev.rishabh.dailytracker/.debug.ComponentGalleryActivity
        -->
        <activity
            android:name="dev.rishabh.dailytracker.debug.TokenGalleryActivity"
            android:exported="true"
            android:label="DT · Tokens"
            android:theme="@style/Theme.DailyTracker" />

        <activity
            android:name="dev.rishabh.dailytracker.debug.ComponentGalleryActivity"
            android:exported="true"
            android:label="DT · Components"
            android:theme="@style/Theme.DailyTracker" />
    </application>

</manifest>
